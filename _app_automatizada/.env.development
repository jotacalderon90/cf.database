#Puerto del sistema a utilizar, debe coincidir con el archivo de docker-compose
PORT: 3302

#Host del sistema
HOST: "http://172.27.16.1:3302" 

#Host del sistema de archivos publicos
HOST_ARCHIVOSPUBLICOS: "http://172.27.16.1:2201" 

#Motor (mongo)
DB_MOTOR=mongo

#Conexion mongodb
