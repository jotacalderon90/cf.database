#####################################
#DATOS GLOBALES FRAMEWORK TRASCENDER#
#####################################

#Puerto del sistema a utilizar, debe coincidir con el archivo de docker-compose
PORT=2204

#Host del sistema, en dev: http://ip:puerto, en prod: https://www.tudominio.com
HOST=http://localhost:2204

#Titulo del sistema, usado en title Front
TITLE=Sistema de datos


##############################
#INTEGRACION DE OTROS SISTEMAS
##############################


#Host archivos públicos
HOST_ARCHIVOSPUBLICOS=http://localhost:2201

#Host de cuentas
HOST_ACCOUNT=http://account:2202

#Host de cms
HOST_CMS=http://localhost:2210

#Sistema para gestión de analitica
#HOST_ANALYTIC=
#HOST_ANALYTIC_X_API_KEY=

#Sistema para gestión de errores
#HOST_ERROR=
#HOST_ERROR_X_API_KEY=


###############
#Autenticacion#
###############


#Llave compartida entre aplicaciones para el manejo de la sesion
SESSION_SECRET=trascender-con-sso

#Para produccion, dominio permitido para uso de cookie
#COOKIE_DOMAIN=


###############
#*****BD******#
###############

#Motor (mongo/oracle)
DB_MOTOR=mongo

MONGO_URL=mongodb://mongodb_service:27017
MONGO_DBNAME=miscolecciones

#SESION_STORAGE_HOST=redis
#SESION_STORAGE_PORT=6379


#########################
#DATOS EXTRAS PRODUCCION#
#########################


#Para producción, valida que sistema solo pueda ser llamado por dominios y no por ips
#ONLYDOMAIN=1

#Sistema con multiples front = 1
FRONT_MULTIDOMAIN=1

#Para desarrollo
TEST_HOST=jotace.cl

#Para generación de monitor (campo obligatorio)
HOST_MONITOR=jotace.cl

#integración swagger
SWAGGER=/api/swagger

#Para configuracion cron que monitorea, por defecto cada 1 minuto, en produccion cada 1 hora mejor
CRON_CHEDULE_MONITOR=* * * * *

#ZonaHoraria para grafico
TIMEZONE=America/Santiago
